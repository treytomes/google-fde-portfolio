# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Development path (Days 1–3) ───────────────────────────────────────────────
# Free Gemini API key — obtain from https://aistudio.google.com/app/apikey
# No GCP billing account required.
GEMINI_API_KEY=your-gemini-api-key-here

# ── Vertex AI verification path (Day 4) ───────────────────────────────────────
# GCP project with Vertex AI API enabled and billing attached.
# Auth via: gcloud auth application-default login
GCP_PROJECT_ID=your-gcp-project-id      # e.g. my-project-123456
GCP_PROJECT_NUMBER=your-project-number  # e.g. 1060758748741
GCP_LOCATION=us-central1               # Vertex AI region
